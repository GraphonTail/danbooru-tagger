# Normalize line endings for all text files to LF on commit
* text=auto eol=lf

# Python source — always LF
*.py    text eol=lf

# Markdown / JSON / plain text — always LF
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.ini   text eol=lf

# Binary files — never diff, never mangle line endings
*.pth   binary
*.pt    binary
*.ckpt  binary
*.safetensors binary
*.png   binary
*.jpg   binary
*.jpeg  binary

# Dev-only files — excluded from GitHub ZIP downloads
.gitattributes  export-ignore
.gitignore      export-ignore
